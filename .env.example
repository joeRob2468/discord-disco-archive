# Copy to .env and fill in. .env is git-ignored; never commit real values.
# Read by Docker Compose (env_file + ${VAR} interpolation) and by `node --env-file`.
# Quote any value containing "#", which otherwise starts a comment.
# Keys marked (planned) are documented now but not read by the code yet.

# --- Discord bot ---------------------------------------------------------------
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
# User ID of the dedicated recorder account (used for the pre-flight permission check)
RECORDER_USER_ID=
# Who can use /record by default: Everyone, or a discord.js PermissionFlagsBits name
# (e.g. ManageEvents). Admins can still override per role/channel in Server Settings → Integrations.
COMMAND_DEFAULT_PERMISSION=ManageEvents
# Optional comma-separated role IDs; if set, only these roles may use /record
ALLOWED_ROLE_IDS=
# Post "Now recording" / "Finished" messages in the voice channel's chat
ANNOUNCE_SETS=true

# --- Browser / capture ---------------------------------------------------------
# chrome (Google Chrome, amd64 only) or chromium
BROWSER_CHANNEL=chrome
# Discord's stream volume slider (1-100). Below 100 leaves headroom against clipping;
# post-processing levels the result, so a lower capture level is fine.
STREAM_VOLUME=85
RECORD_VIDEO=false
VIDEO_FPS=30
VIDEO_SIZE=1920x1080
# Restart of the same DJ's stream within this many seconds continues the same set
RESTART_GRACE_SECONDS=60
# Switch away from a stream that is silent this long while someone else is live
HANDOVER_SILENCE_SECONDS=45

# --- Leveling / exports --------------------------------------------------------
TARGET_LUFS=-14
TARGET_TP=-1
TARGET_LRA=11
# Comma list of derived formats: mp3, m4a
EXPORT_FORMATS=mp3,m4a
# Delete raw captures this many days after leveling; empty keeps them forever (planned)
RAW_RETENTION_DAYS=

# --- Storage -------------------------------------------------------------------
# App state (recorder browser profile, archive database), mounted at /config.
# Home server: /mnt/media/docker_data/discord-stream-recorder
APP_DATA_DIR=./docker-data
# Recordings (the actual media), mounted at /recordings.
# Home server: /mnt/media/data/media/discord-sets
RECORDINGS_HOST_DIR=./data/recordings
TZ=America/Chicago
# Host user/group that own APP_DATA_DIR and RECORDINGS_HOST_DIR (`id -u`, `id -g`)
PUID=1000
PGID=1000

# --- noVNC (one-time login, debugging) -----------------------------------------
VNC_ENABLED=true
# Host port, always bound to 127.0.0.1
VNC_PORT=6080
VNC_PASSWORD=

# --- Archive -------------------------------------------------------------------
ARCHIVE_PORT=3000
ARCHIVE_PUBLIC_URL=http://localhost:3000
# Optional shared viewer password (8+ chars); empty = public
ARCHIVE_PASSWORD=
# Admin password (12+ chars) for hiding/editing sets; empty = editing disabled
ARCHIVE_ADMIN_PASSWORD=
# Signs login cookies (32+ chars); required if either password is set.
# Generate: openssl rand -hex 32
ARCHIVE_SESSION_SECRET=
# Full rescan interval; file watching picks up most changes sooner
ARCHIVE_SYNC_INTERVAL_SECONDS=300

# --- Home server only ----------------------------------------------------------
# COMPOSE_FILE=compose.yaml:compose.server.yaml
# DOMAIN=example.com

# --- Logging -------------------------------------------------------------------
LOG_LEVEL=info
